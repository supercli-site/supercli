{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Edge model leaderboard snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshot_date", "methodology", "models"],
  "properties": {
    "snapshot_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "size_basis", "download_basis", "ranking", "license_note"],
      "properties": {
        "scope": { "type": "string", "minLength": 1 },
        "size_basis": { "type": "string", "minLength": 1 },
        "download_basis": { "type": "string", "minLength": 1 },
        "ranking": { "type": "string", "minLength": 1 },
        "license_note": { "type": "string", "minLength": 1 }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "name", "creator", "task", "task_en", "params",
          "format", "format_en", "license", "deploy_mb", "size_basis",
          "downloads", "languages", "source", "note", "note_en"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "creator": { "type": "string", "minLength": 1 },
          "task": { "type": "string", "minLength": 1 },
          "task_en": { "type": "string", "minLength": 1 },
          "params": { "type": "string", "minLength": 1 },
          "format": { "type": "string", "minLength": 1 },
          "format_en": { "type": "string", "minLength": 1 },
          "license": { "type": "string", "minLength": 1 },
          "deploy_mb": { "type": "number", "exclusiveMinimum": 0 },
          "size_basis": { "type": "string", "minLength": 1 },
          "downloads": { "type": "integer", "minimum": 0 },
          "languages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 2 }
          },
          "source": { "type": "string", "pattern": "^https://huggingface\\.co/" },
          "note": { "type": "string", "minLength": 1 },
          "note_en": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
