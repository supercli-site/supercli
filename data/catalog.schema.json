{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "vendor",
      "category",
      "repo",
      "description",
      "install",
      "docs",
      "icon",
      "maintainerType"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60
      },
      "vendor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60
      },
      "category": {
        "enum": ["cloud", "ai", "dev", "terminal", "data", "media", "security", "api"]
      },
      "repo": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+$"
          },
          {
            "type": "null"
          }
        ]
      },
      "description": {
        "type": "string",
        "minLength": 10,
        "maxLength": 160
      },
      "install": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 3,
            "maxLength": 180,
            "pattern": "^[^\\n\\r<>]+$"
          },
          {
            "type": "null"
          }
        ]
      },
      "docs": {
        "type": "string",
        "pattern": "^https://[^\\s<>\"']+$"
      },
      "icon": {
        "type": "string",
        "pattern": "^[a-z0-9-]+\\.(png|svg)$"
      },
      "locallyInstalled": {
        "type": "boolean"
      },
      "maintainerType": {
        "enum": ["vendor", "community"]
      },
      "api": {
        "type": "object",
        "additionalProperties": false,
        "description": "纯 API 服务条目的接入与计费信息；category=api 时必填，CLI 条目不带此字段。",
        "required": ["endpoint", "protocol", "auth", "pricing"],
        "properties": {
          "endpoint": {
            "type": "string",
            "pattern": "^https://[^\\s<>\"']+$"
          },
          "protocol": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "auth": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "pricing": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          },
          "sdk": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "pricingSourceId": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "指向 data/pricing-sources.json 的厂商 id —— 价格明细从该登记表的巡检快照渲染，目录条目里不写死价格数字。"
          }
        }
      }
    }
  }
}
